# ARC-AI Mobile environment
#
# Expo inlines ONLY variables prefixed with EXPO_PUBLIC_ into the app bundle.
# Never put secrets here — they are readable by anyone with the APK.
#
# EXPO_PUBLIC_API_URL
#   Origin of the ARC-AI backend (no trailing slash, no /api suffix).
#   REST is served at <url>/api and Socket.IO at <url>/socket.io, so this
#   single value covers both — no separate socket variable is required.
#
# Examples (replace with your own):
#   Hosted backend:   https://<your-backend-host>
#   Android emulator: http://10.0.2.2:5000
#   iOS simulator:    http://localhost:5000
#   Physical device:  http://<your-computer-LAN-IP>:5000

EXPO_PUBLIC_API_URL=

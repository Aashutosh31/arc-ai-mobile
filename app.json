{
  "expo": {
    "name": "ARC-AI",
    "slug": "arc-ai-mobile",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arcaimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.arcai.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.arcai.mobile",
      "versionCode": 14,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ARC-AI to use the microphone for voice mode."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ARC-AI to use the camera so you can send images to the assistant."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ARC-AI to access your photos so you can attach images."
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
